{
  "manifest_version": 3,
  "name": "私有书签",
  "version": "0.1.0",
  "description": "私有书签、高亮和失效链接检查。",
  "icons": {
    "16": "icons/bookmark.png",
    "32": "icons/bookmark.png",
    "48": "icons/bookmark.png",
    "128": "icons/bookmark.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/bookmark.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["https://*/*"],
  "omnibox": {
    "keyword": "pb"
  },
  "commands": {
    "save_page": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "保存页面或高亮"
    },
    "open_side_panel": {
      "suggested_key": { "default": "Ctrl+Period" },
      "description": "打开私有书签侧边栏"
    }
  }
}
